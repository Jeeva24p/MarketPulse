# ---- GCP / BigQuery ----
# GCP project that hosts the BigQuery datasets.
GCP_PROJECT_ID=your-gcp-project-id
# Absolute path to the service-account JSON key (never commit this file).
GCP_SA_KEY_PATH=/path/to/marketpulse-sa.json

# ---- BigQuery datasets & tables ----
BIGQUERY_RAW_DATASET=marketpulse_raw
BIGQUERY_ANALYTICS_DATASET=marketpulse_analytics
BIGQUERY_RAW_TABLE=market_ticks
BIGQUERY_GOLD_TABLE=fact_daily_metrics
BIGQUERY_ANOMALY_TABLE=fact_anomaly_scores

# ---- MLflow ----
# SQLite tracking store. Artifacts are written to ./mlruns/.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# ---- Alerting (Slack / Discord incoming webhook) ----
# Leave empty to disable alert delivery (alerts then no-op).
ALERT_WEBHOOK_URL=

# ---- Tickers & universe ----
TICKERS=AAPL,MSFT,GOOGL,NVDA,SPY,BTC-USD
LOOKBACK_DAYS=30

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=logs/marketpulse.log

# ---- Anomaly scoring ----
ANOMALY_CONTAMINATION=0.05
RISK_SCORE_HIGH=85
